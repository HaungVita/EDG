# Copy this file to configs/paths.env and update the paths.
# Model directories must contain model.ckpt and the matching historical opt.json.

PYTHON_BIN=/root/miniconda3/envs/torch/bin/python

TVR_VAL_JSONL=/path/to/new_keep_name_tvr_val_release.jsonl
TVR_VR_TRAIN_JSONL=/path/to/tvr_train_select100_release.jsonl
TVR_MOMENT_TRAIN_JSONL=/path/to/tvr_neg_train_select100_release.jsonl
QUERY_H5=/path/to/tvr_query_pretrained_w_sub_query.h5
SUB_H5=/path/to/tvr_sub_pretrained_w_sub_query_max_cl-1.5.h5
SUB_INFO_JSON=/path/to/tvr_sub_pretrained_w_sub_query_max_cl-1.5_sub_info.json
DURATION_JSON=/path/to/tvr_video2dur_idx.json
SLOWFAST_H5=/path/to/slowfast_data.h5

FACE_H5=/path/to/face_mean_MeanOfAllFaces_with_count_cl-1.5.h5
PORTRAIT_H5=/path/to/nid2face_feat_avr20_change.h5

VR_MODEL_DIR=/path/to/tvr-video_face_sub-DK-2024_11_04_13_46_11
SVMR_MODEL_DIR=/path/to/tvr-video_sub-test_run_face-2024_10_13_19_36_58
VCMR_MODEL_DIR=/path/to/a/writable/copy/of/the/SVMR/model/directory

# Produced by the NetVLAD first stage with sigma=40 reranking.
VCMR_VR_INPUT=/path/to/inference_tvr_val_sigma_40_predictions_VCMR_SVMR_VR.json

# Moment training uses first-stage candidates on the TVR training split.
TRAIN_VR_INPUT=/path/to/inference_tvr_train_2_predictions_VCMR_SVMR_VR.json
IDX2VIDEO_JSON=/path/to/idx2video.json
TRAIN_RESULTS_ROOT=/path/to/writable/training_outputs
